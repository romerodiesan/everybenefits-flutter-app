{
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.tsserver.maxTsServerMemory": 4096,
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": [
    { "directory": "apps/web", "changeProcessCWD": true },
    { "directory": "apps/studio", "changeProcessCWD": true },
    { "directory": "apps/admin", "changeProcessCWD": true },
    { "directory": "apps/functions", "changeProcessCWD": true },
    { "directory": "packages/shared", "changeProcessCWD": true },
    { "directory": "packages/firebase-web", "changeProcessCWD": true }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "dart.projectSearchDepth": 5,
  "dart.analysisExcludedFolders": [
    "apps/web",
    "apps/studio",
    "apps/admin",
    "apps/functions",
    "packages",
    "tooling",
    "node_modules",
    ".pnpm-store"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/.pnpm-store/**": true,
    "**/apps/functions/lib/**": true,
    "**/packages/*/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.pnpm-store": true,
    "**/apps/functions/lib": true,
    "**/packages/*/dist": true
  }
}
