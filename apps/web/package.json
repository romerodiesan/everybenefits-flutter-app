{
  "name": "@pulse/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "generate:messaging-sw": "node ./scripts/generate-firebase-messaging-sw.mjs",
    "predev": "pnpm run generate:messaging-sw",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm run generate:messaging-sw",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:ai": "vitest run lib/ai/evals"
  },
  "dependencies": {
    "@ai-sdk/react": "~4.0.51",
    "@lottiefiles/dotlottie-react": "~0.19.12",
    "@pulse/firebase-web": "workspace:*",
    "@pulse/shared": "workspace:*",
    "ai": "~7.0.48",
    "firebase": "~12.17.0",
    "firebase-admin": "~14.2.0",
    "motion": "~12.43.0",
    "next": "16.2.12",
    "next-intl": "~4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "~10.1.0",
    "remark-gfm": "~4.0.1",
    "server-only": "~0.0.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@pulse/eslint-config": "workspace:*",
    "@pulse/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "~4",
    "@types/node": "~20",
    "@types/react": "~19",
    "@types/react-dom": "~19",
    "eslint": "~9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "~4",
    "typescript": "~5",
    "vitest": "~4.1.10"
  }
}
