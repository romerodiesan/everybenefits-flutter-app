# Copy to .env.local. Public Firebase web SDK config for every-benefits-us.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD7SRc2CY4ggUITwIqXNp1i1SPmcsTc-xk
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=every-benefits-us.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=every-benefits-us
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=every-benefits-us.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1001601265155
NEXT_PUBLIC_FIREBASE_APP_ID=1:1001601265155:web:f03d9d5d1f14602dd8e836
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://every-benefits-us-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-BM8TQCEQQN
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# Google Maps Platform (browser key, HTTP referrer restricted). Enables Place Autocomplete
# on agent address fields. Optional — without it, users type addresses manually.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Web Push (Firebase Console → Project settings → Cloud Messaging → Web Push certificates)
# Public client key — safe to expose in the browser bundle.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# App Check is off. Opt-in later:
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# PULSE_SSO_REQUIRE_APP_CHECK=true
# PULSE_AI_REQUIRE_APP_CHECK=true
# Local: Auth 9099 / Firestore 8080 / RTDB 9000 / Storage 9199 / Functions 5001
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# When opening the app from a phone/LAN IP (http://10.x.x.x:3000), set the same
# host. Leave unset when using http://localhost — the client uses loopback then.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.0.77
# Server-side Admin SDK (Next.js API routes) must point at the same emulators.
# Without these, /api/ai/* returns 401 verifying emulator tokens against prod Auth.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Pulse AI agent (server-side only) ---
# Vercel AI Gateway key (vck_…). On Vercel this can also come from OIDC.
AI_GATEWAY_API_KEY=
# Firebase Admin credentials: full service-account JSON, inline or base64.
# Not required against emulators; required for production / preview.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=every-benefits-us
# Models (any AI Gateway id). Leave unset to use the defaults in lib/ai/config.ts.
PULSE_AI_MODEL=anthropic/claude-sonnet-5
PULSE_AI_FAST_MODEL=google/gemini-3.6-flash
PULSE_AI_EMBEDDING_MODEL=google/gemini-embedding-001
PULSE_AI_EMBEDDING_DIMENSIONS=768
# Quotas and safety. App Check off unless PULSE_AI_REQUIRE_APP_CHECK=true.
PULSE_AI_DAILY_MESSAGE_LIMIT=60
PULSE_AI_PER_MINUTE_MESSAGE_LIMIT=8
PULSE_AI_MAX_WEB_SEARCHES_PER_RUN=1
PULSE_AI_MAX_EMBEDDING_SEARCHES_PER_RUN=4
PULSE_AI_REQUIRE_APP_CHECK=false
PULSE_AI_ALLOW_ANONYMOUS=false
# Live lookups on official domains: tavily | brave | none
PULSE_AI_WEB_SEARCH_PROVIDER=tavily
PULSE_AI_WEB_SEARCH_API_KEY=
# Shared secret for POST /api/ai/reindex from a cron job.
PULSE_AI_ADMIN_TASK_KEY=

# Adjacent Pulse Studio authoring app (SSO + redirects)
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001
# This Pulse web origin (used by Studio SSO bridge)
NEXT_PUBLIC_PULSE_WEB_URL=http://localhost:3000

NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
# Legal center (SvelteKit static app)
NEXT_PUBLIC_LEGAL_ORIGIN=http://localhost:3003
