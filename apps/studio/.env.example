# Copy to .env.local — use a placeholder here, never commit real keys.
# App Hosting injects NEXT_PUBLIC_FIREBASE_API_KEY from secret FIREBASE_WEB_API_KEY.
# Firebase (same project as Pulse webapp)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=every-benefits-us.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=every-benefits-us
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=every-benefits-us.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1001601265155
NEXT_PUBLIC_FIREBASE_APP_ID=1:1001601265155:web:f03d9d5d1f14602dd8e836
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://every-benefits-us-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-BM8TQCEQQN
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
# reCAPTCHA Enterprise (Fraud Defense) site key for App Check — same as Pulse.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Enforce App Check on SSO API routes (defaults to on when site key is set)
# PULSE_SSO_REQUIRE_APP_CHECK=true
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# When opening Studio from a phone/LAN IP, set the same host. Leave unset on localhost.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=10.0.0.77

# Server Admin (SSO exchange). With emulators, project id is enough.
FIREBASE_PROJECT_ID=every-benefits-us
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_SERVICE_ACCOUNT_KEY=

# Pulse learner app (redirects / no-access links)
NEXT_PUBLIC_PULSE_WEB_URL=http://localhost:3000

# Studio public URL (used in cutover redirects from Pulse)
NEXT_PUBLIC_STUDIO_URL=http://localhost:3001

# Optional: GA4→BigQuery dataset for audience geo/device (requires Blaze)
# BIGQUERY_ANALYTICS_DATASET=analytics_XXXXXX

NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
