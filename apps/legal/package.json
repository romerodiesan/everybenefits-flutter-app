{
  "name": "@pulse/legal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite dev --port 3003",
    "build": "vite build",
    "apphosting:build": "pnpm run build",
    "start": "node ./server.js",
