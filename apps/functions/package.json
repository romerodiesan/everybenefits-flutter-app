{
  "name": "@pulse/functions",
  "description": "Trusted callables for votes, roles, academy, org, and SSO",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "sync:shared": "node ./scripts/sync-pulse-shared.mjs",
    "build": "pnpm run sync:shared && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run --config vitest.config.mts",
    "serve": "pnpm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@pulse/shared": "file:./vendor/pulse-shared",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "private": true
}
