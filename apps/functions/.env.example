# Server-side Google Maps Platform key for Address Validation API
# (callable validateUsAddress). Prefer a key restricted to the API + IP/server.
# Leave empty to soft-skip validation (local validators still apply).
GOOGLE_MAPS_API_KEY=

# App Check is opt-in. Leave unset (or false) unless you are ready to enforce.
# FUNCTIONS_ENFORCE_APP_CHECK=true

# Extra CORS origins (comma-separated) for staging / App Hosting previews.
# Preview hosts matching *-every-benefits-us.us-central1.hosted.app are allowed
# automatically. Localhost is never allowed in production unless:
# FUNCTIONS_ALLOW_LOCALHOST=true
# FUNCTIONS_ALLOWED_ORIGINS=https://staging.example.com

# One-shot org tree migrations (migrateSubAgenciesToAgencies). Off by default.
# FUNCTIONS_ALLOW_ORG_MIGRATIONS=true

# Required in production. Local emulators derive it from GCLOUD_PROJECT
# (every-benefits-us-default-rtdb.firebaseio.com) when unset.
# FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
