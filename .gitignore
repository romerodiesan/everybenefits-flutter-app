# Accidental tsc emit of next.config.ts → next.config.js (breaks next-intl CJS interop)
apps/*/next.config.js
# Accidental tsc emit beside TypeScript sources (never commit)
apps/**/proxy.js
apps/web/**/*.js
apps/admin/**/*.js
apps/studio/**/*.js
apps/payments/**/*.js
apps/legal/**/*.js
!apps/*/scripts/**
!apps/*/public/**
!apps/*/test/stubs/**
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Flutter mobile
