rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerFile(fileName) {
      return isSignedIn() && fileName == request.auth.uid + '.jpg';
    }

    function isAllowedImageType() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/webp';
    }

    function isAllowedVideoType() {
      return request.resource.contentType == 'video/mp4'
        || request.resource.contentType == 'video/quicktime'
        || request.resource.contentType == 'video/webm';
    }

    // Cross-service lookups: academy writes are gated by the Firestore role
    // and course ownership, mirroring firestore.rules.
    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAccountActive() {
      return hasProfile()
        && !(userData().get('accountStatus', 'active')
          in ['deactivated', 'pendingDeletion']);
    }

    function callerRole() {
      return userData().get('role', '');
    }

    function isAdmin() {
      return isAccountActive() && callerRole() == 'admin';
    }

    function isRegisteredMember() {
      return isAccountActive()
        && userData().get('isAnonymous', true) == false
        && callerRole() != 'guest';
    }

    function ownsCourse(courseId) {
      return firestore.exists(/databases/(default)/documents/courses/$(courseId))
        && firestore.get(/databases/(default)/documents/courses/$(courseId))
          .data.get('createdBy', '') == request.auth.uid;
    }

    function canWriteCourseFiles(courseId) {
      return isAdmin()
        || (
          isAccountActive()
          && callerRole() in ['instructor', 'teacher', 'manager']
          && ownsCourse(courseId)
        );
    }

    function canReadCourseFiles(courseId) {
      return firestore.exists(/databases/(default)/documents/courses/$(courseId))
        && (
          (firestore.get(/databases/(default)/documents/courses/$(courseId))
            .data.get('status', 'draft') == 'published'
            && isRegisteredMember())
          || isAdmin()
          || (isAccountActive() && ownsCourse(courseId))
        );
    }

    match /avatars/{fileName} {
      // Own-avatar writes only need Auth + path ownership. Avoid Firestore
      // cross-service lookups here — a failed get() fails closed as 403 and
      // blocks profile photo uploads for otherwise valid members.
      // Reads: registered (non-guest) members, or the owner of the file.
      allow read: if isOwnerFile(fileName) || isRegisteredMember();
      allow write: if isSignedIn()
        && isOwnerFile(fileName)
        && request.resource.size < 5 * 1024 * 1024
        && isAllowedImageType();
    }

    // Agency / matrix logos: org-logos/{orgNodeId}.jpg
    match /org-logos/{fileName} {
      allow read: if isRegisteredMember();
      allow write: if isSignedIn()
        && isAccountActive()
        && callerRole() in ['admin', 'system']
        && request.resource.size < 5 * 1024 * 1024
        && isAllowedImageType();
    }

    // Course covers and lesson videos: /courses/{courseId}/...
    match /courses/{courseId}/{allPaths=**} {
      allow read: if canReadCourseFiles(courseId);

      allow create, update: if canWriteCourseFiles(courseId)
        && (
          (isAllowedImageType() && request.resource.size < 5 * 1024 * 1024)
          || (isAllowedVideoType()
              && request.resource.size < 2 * 1024 * 1024 * 1024)
        );

      allow delete: if canWriteCourseFiles(courseId);
    }
  }
}
