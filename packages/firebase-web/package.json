{
  "name": "@pulse/firebase-web",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./firebase-next": {
      "types": "./firebase-next.cjs.d.ts",
      "require": "./firebase-next.cjs",
      "import": "./firebase-next.cjs",
      "default": "./firebase-next.cjs"
    }
  },
  "files": ["dist", "src", "firebase-next.cjs", "firebase-next.cjs.d.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@pulse/shared": "workspace:*"
  },
  "peerDependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@pulse/typescript-config": "workspace:*",
    "firebase": "^12.17.0",
    "typescript": "^5.9.3"
  }
}
