{
  "rules": {
    ".read": false,
    ".write": false,

    "chats": {
      "$chatId": {
        ".read": "auth != null && data.child('members').child(auth.uid).val() === true",

        // Create only (Admin SDK bypasses for agents-default).
        // Field updates use the child rules below — do not compare maps with ===
        // (RTDB object equality is unreliable and was denying lastMessage updates).
        ".write": "auth != null
          && !data.exists()
          && newData.child('createdBy').val() === auth.uid
          && newData.child('members').child(auth.uid).val() === true
          && newData.child('isDefaultAgentGroup').val() !== true
          && (
            (newData.child('isGroup').val() === false
              && newData.child('dmKey').val() === $chatId)
            || newData.child('isGroup').val() === true
          )",

        "lastMessage": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "lastMessageAt": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "lastMessageSenderId": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "unreadCounts": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "pinnedBy": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "memberNames": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        },
        "title": {
          ".write": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        ".indexOn": ["createdAt"],
        "$messageId": {
          ".write": "auth != null
            && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true
            && newData.child('senderId').val() === auth.uid
            && !data.exists()"
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastMessageAt"],
        "$chatId": {
          ".write": "auth != null && (
            auth.uid === $uid
            || root.child('chats').child($chatId).child('members').child(auth.uid).val() === true
          )"
        }
      }
    },

    "dmIndex": {
      "$dmKey": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
