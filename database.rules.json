{
  "rules": {
    ".read": false,
    ".write": false,

    "chats": {
      "$chatId": {
        // Allow missing nodes so clients can probe before create (null).
        // Existing chats still require membership.
        ".read": "auth != null && (
          !data.exists()
          || data.child('members').child(auth.uid).val() === true
        )",

        // Client may only create their own support thread.
        // DMs and groups are created via Admin SDK callables.
        ".write": "auth != null
          && !data.exists()
          && newData.child('createdBy').val() === auth.uid
          && newData.child('members').child(auth.uid).val() === true
          && newData.child('isDefaultAgentGroup').val() !== true
          && newData.child('isSupportChat').val() === true
          && newData.child('isGroup').val() === true
          && $chatId === ('support_' + auth.uid)
          && newData.child('members').child('support-ai').val() === true",

        // lastMessage* — Admin SDK only (syncChatMetadataOnMessage / callables).
        "unreadCounts": {
          "$uid": {
            ".write": "auth != null
              && auth.uid === $uid
              && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
          }
        },
        "pinnedBy": {
          "$uid": {
            ".write": "auth != null
              && auth.uid === $uid
              && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true"
          }
        },
        "memberNames": {
          "$uid": {
            // Members may only set/clear their own display name entry.
            ".write": "auth != null
              && auth.uid === $uid
              && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true
              && (!newData.exists() || newData.isString())"
          }
        },
        // Group titles are set by Admin SDK callables only.
        "title": {
          ".write": false
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true",
        ".indexOn": ["createdAt"],
        "$messageId": {
          // Members may only post as themselves. Bot replies ('support-ai')
          // are written by the postSupportAiMessage callable with the Admin
          // SDK, which bypasses these rules — a client can never impersonate.
          ".write": "auth != null
            && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true
            && !data.exists()
            && newData.child('senderId').val() === auth.uid
            && newData.child('isAi').val() !== true
            && newData.child('body').isString()
            && newData.child('body').val().length > 0
            && newData.child('body').val().length <= 4000
            && newData.child('senderName').isString()
            && newData.child('senderName').val().length <= 120
            && newData.child('createdAt').isNumber()",
          "reactions": {
            "$uid": {
              ".write": "auth != null
                && auth.uid === $uid
                && root.child('chats').child($chatId).child('members').child(auth.uid).val() === true
                && root.child('chats').child($chatId).child('isSupportChat').val() !== true
                && (!newData.exists() || newData.isString())"
            }
          }
        }
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".indexOn": ["lastMessageAt"],
        "$chatId": {
          // Membership required to create/update; delete allowed after leaving.
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('chats').child($chatId).child('members').child(auth.uid).val() === true)"
        }
      }
    },

    "dmIndex": {
      "$dmKey": {
        // Only the two participants can resolve a DM key (uidA_uidB).
        ".read": "auth != null && ($dmKey.beginsWith(auth.uid + '_') || $dmKey.endsWith('_' + auth.uid))",
        ".write": false
      }
    },

    "presence": {
      // Non-anonymous Auth only. Use auth.provider (RTDB classic) — more
      // reliable on the Auth emulator than token.firebase.sign_in_provider.
      ".read": "auth != null && auth.provider != 'anonymous'",
      "$uid": {
        "$clientId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['at']) && (newData.child('at').isNumber() || newData.child('at').val() === now)"
        }
      }
    },

    // Shallow online index for cheap headcount (one node per uid).
    "online": {
      ".read": "auth != null && auth.provider != 'anonymous'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.val() === true"
      }
    },

    // Admin SDK only — maps role → chatIds for auto-join groups.
    "autoJoinGroups": {
      ".read": false,
      ".write": false
    }
  }
}
