{
  "name": "pulse-monorepo",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@pulse/web",
    "build:studio": "turbo run build --filter=@pulse/studio",
    "build:admin": "turbo run build --filter=@pulse/admin",
    "build:legal": "turbo run build --filter=@pulse/legal",
    "test": "turbo run test",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck",
    "dev:web": "pnpm --filter @pulse/web dev",
    "dev:studio": "pnpm --filter @pulse/studio dev",
    "dev:admin": "pnpm --filter @pulse/admin dev",
    "dev:legal": "pnpm --filter @pulse/legal dev",
    "emulators": "bash ./tooling/scripts/start-emulators.sh",
    "seed": "node ./tooling/scripts/seed-mega.mjs",
    "seed:quick": "SEED_PROFILE=quick node ./tooling/scripts/seed-mega.mjs",
    "seed:mega": "node ./tooling/scripts/seed-mega.mjs",
    "sync:functions-shared": "pnpm --filter @pulse/functions run sync:shared",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,database,storage",
    "deploy:functions": "pnpm sync:functions-shared && firebase deploy --only functions",
    "deploy:web": "firebase deploy --only apphosting:pulse-web-app",
    "deploy:studio": "firebase deploy --only apphosting:studio-web-app",
    "deploy:admin": "firebase deploy --only apphosting:admin-web-app",
    "deploy:legal": "pnpm build:legal && firebase deploy --only hosting:legal"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "~5.9.3"
  }
}
