{
  "name": "pulse-monorepo",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck",
    "dev:webapp": "pnpm --filter webapp dev",
    "dev:studio": "pnpm --filter pulse-studio dev",
    "dev:admin": "pnpm --filter pulse-admin dev",
    "emulators": "bash ./scripts/start-emulators.sh",
    "sync:functions-shared": "pnpm --filter every-benefits-functions run sync:shared"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}
