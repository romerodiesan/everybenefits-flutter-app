{
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Every Insurance",
        "supportEmail": "support@everybenefits.us"
      }
    }
  },
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "target": "legal",
      "public": "apps/legal/build",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.@(js|css|svg|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ]
    }
  ],
  "apphosting": [
    {
      "backendId": "pulse-web-app",
      "rootDir": "apps/web",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "apps/mobile",
        "apps/functions",
        "apps/studio",
        "apps/admin",
        "apps/legal",
        "docs",
        "tooling",
        "test"
      ],
      "alwaysDeployFromSource": true
    },
    {
      "backendId": "studio-web-app",
      "rootDir": "apps/studio",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "apps/mobile",
        "apps/functions",
        "apps/web",
        "apps/admin",
        "apps/legal",
        "docs",
        "tooling",
        "test"
      ],
      "alwaysDeployFromSource": true
    },
    {
      "backendId": "admin-web-app",
      "rootDir": "apps/admin",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "apps/mobile",
        "apps/functions",
        "apps/web",
        "apps/studio",
        "apps/legal",
        "docs",
        "tooling",
        "test"
      ],
      "alwaysDeployFromSource": true
    }
  ],
  "functions": [
    {
      "source": "apps/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "pnpm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "host": "0.0.0.0",
      "port": 9099
    },
    "firestore": {
      "host": "0.0.0.0",
      "port": 8080
    },
    "storage": {
      "host": "0.0.0.0",
      "port": 9199
    },
    "database": {
      "host": "0.0.0.0",
      "port": 9000
    },
    "functions": {
      "host": "0.0.0.0",
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "extensions": {
    "firestore-bigquery-export": "firebase/firestore-bigquery-export@0.1.60"
  }
}
