rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerRole() {
      return userDoc(request.auth.uid).data.role;
    }

    function isAdmin() {
      return hasUserProfile() && callerRole() == 'admin';
    }

    function isForumParticipant() {
      return hasUserProfile()
        && callerRole() in ['student', 'agent', 'instructor', 'admin'];
    }

    function isBootstrapRole() {
      return request.resource.data.role in ['guest', 'student', 'agent'];
    }

    function isProtectedRole(role) {
      return role in ['instructor', 'admin'];
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isBootstrapRole()
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && !isProtectedRole(request.resource.data.role)
        && (
          request.resource.data.role == resource.data.role
          || !isProtectedRole(resource.data.role)
        );
      allow read, update, delete: if isAdmin();
    }

    match /threads/{threadId} {
      allow read: if isSignedIn();

      allow create: if isForumParticipant()
        && request.resource.data.authorId == request.auth.uid
        && isNonEmptyString(request.resource.data.title)
        && isNonEmptyString(request.resource.data.body)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() > 0
        && request.resource.data.tags.size() <= 5
        && request.resource.data.replyCount == 0
        && request.resource.data.score == 0;

      allow update: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || isAdmin()
          || (
            isForumParticipant()
            && request.resource.data.authorId == resource.data.authorId
            && request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.tags == resource.data.tags
          )
        );

      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isForumParticipant()
          && request.auth.uid == uid
          && request.resource.data.value is int
          && (request.resource.data.value == 1
              || request.resource.data.value == -1);
        allow delete: if isForumParticipant()
          && request.auth.uid == uid;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();

        allow create: if isForumParticipant()
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyString(request.resource.data.body)
          && request.resource.data.score == 0;

        allow update: if isSignedIn()
          && (
            resource.data.authorId == request.auth.uid
            || isAdmin()
            || (
              isForumParticipant()
              && request.resource.data.authorId == resource.data.authorId
              && request.resource.data.body == resource.data.body
            )
          );

        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isAdmin());

        match /votes/{uid} {
          allow read: if isSignedIn();
          allow create, update: if isForumParticipant()
            && request.auth.uid == uid
            && request.resource.data.value is int
            && (request.resource.data.value == 1
                || request.resource.data.value == -1);
          allow delete: if isForumParticipant()
            && request.auth.uid == uid;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
