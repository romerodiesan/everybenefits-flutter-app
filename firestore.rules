rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAnonymousAuth() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // Prefer exists()+get() with Map.get defaults so missing fields never
    // throw evaluation errors during list queries.

    /// Absent or "active" = normal. Deactivated / pendingDeletion are blocked
    /// from community + academy (they can still read their own user doc).
    function isAccountActive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && !(userDoc(request.auth.uid).data.get('accountStatus', 'active')
          in ['deactivated', 'pendingDeletion']);
    }

    function isAdmin() {
      return isAccountActive()
        && (
          callerRole() in ['admin', 'system']
          || hasPermission('platform.manage')
        );
    }

    /// Registered members: signed-in, account active, not anonymous Auth.
    /// Profile create cannot be born anonymous, so leftover `role: guest`
    /// docs are orphan data (ops may delete) and are not a live guest mode.
    function isRegisteredMember() {
      return isAccountActive()
        && userDoc(request.auth.uid).data.get('isAnonymous', true) == false;
    }

    function isForumParticipant() {
      return isRegisteredMember()
        && (
          callerRole() in
            ['student', 'agent', 'agency_owner', 'instructor', 'teacher', 'manager', 'admin', 'system']
          || hasPermission('forums.participate')
        );
    }

    // Instructors and managers author courses (published only after admin
    // approval); admins have full control over the academy catalog.
    // Legacy role "teacher" is an alias of instructor.
    function isCourseAuthor() {
      return isAccountActive()
        && (
          callerRole() in ['instructor', 'teacher', 'manager', 'admin', 'system']
          || hasPermission('courses.author')
        );
    }

    function courseData(courseId) {
      return get(/databases/$(database)/documents/courses/$(courseId)).data;
    }

    function courseExists(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId));
    }

    function ownsCourse(courseId) {
      return courseData(courseId).get('createdBy', '') == request.auth.uid;
    }

    function instructsCourse(courseId) {
      return courseExists(courseId)
        && request.auth.uid in courseData(courseId).get('instructorIds', []);
    }

    function canReadCourseAnalytics(courseId) {
      return isAdmin()
        || hasPermission('academy.analytics.read')
        || (
          isCourseAuthor()
          && courseExists(courseId)
          && (ownsCourse(courseId) || instructsCourse(courseId))
        );
    }

    function courseReadable(courseId) {
      return courseExists(courseId)
        && (
          (courseData(courseId).get('status', 'draft') == 'published'
            && isRegisteredMember())
          || isAdmin()
          || (isCourseAuthor() && (ownsCourse(courseId) || instructsCourse(courseId)))
        );
    }

    /// Content edits stay open to the author until an admin publishes.
    function canEditCourse(courseId) {
      return courseExists(courseId)
        && (
          isAdmin()
          || hasPermission('courses.edit.any')
          || (
            isCourseAuthor()
            && ownsCourse(courseId)
            && courseData(courseId).get('status', 'draft') != 'published'
          )
        );
    }

    function validCourseLevel(level) {
      return level in ['basic', 'intermediate', 'advanced'];
    }

    function callerProfile() {
      return userDoc(request.auth.uid).data;
    }

    function callerRole() {
      return callerProfile().get('role', 'student');
    }

    function normalizedCallerRole() {
      let role = callerRole();
      return role == 'teacher' ? 'instructor' : role;
    }

    function roleDocPath() {
      return /databases/$(database)/documents/roles/$(normalizedCallerRole());
    }

    function roleDocExists() {
      return exists(roleDocPath());
    }

    function rolePermissions() {
      return roleDocExists()
        ? get(roleDocPath()).data.get('permissions', [])
        : [];
    }

    /// Permission check against Firestore `roles/{roleId}` when seeded.
    /// Seed built-in roles (`seedSystemRoles`) in every environment; missing
    /// docs make this fail closed (empty list) except the hardcoded role lists.
    function hasPermission(key) {
      return isAccountActive()
        && (
          normalizedCallerRole() == 'system'
          || key in rolePermissions()
        );
    }

    function isProtectedRole(role) {
      return role in ['instructor', 'teacher', 'manager', 'admin', 'system'];
    }

    function boundedString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function optionalBoundedString(value, maxLen) {
      return value == null
        || (value is string && value.size() <= maxLen);
    }

    /// Co-instructors list: cap size to limit blast radius of mistaken grants.
    function validInstructorIds(ids) {
      return ids is list && ids.size() <= 20;
    }

    function courseAuthorUpdateKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'title', 'description', 'teacherName', 'instructorIds', 'level',
          'status', 'coverPath', 'coverUrl', 'lessonCount', 'durationMinutes',
          'updatedAt', 'publishedAt'
        ]);
    }

    function moduleWriteKeys() {
      return request.resource.data.keys()
        .hasOnly(['title', 'order', 'updatedAt', 'createdAt']);
    }

    function lessonWriteKeys() {
      return request.resource.data.keys()
        .hasOnly([
          'moduleId', 'title', 'order', 'type', 'durationSeconds',
          'instructorId', 'videoPath', 'videoUrl', 'videoFileName',
          'bodyMarkdown', 'questions', 'passPercent', 'updatedAt', 'createdAt'
        ]);
    }

    function lessonTypeValid(type) {
      return type in ['video', 'reading', 'quiz'];
    }

    function validTags(tags) {
      return tags is list
        && tags.size() > 0
        && tags.size() <= 5
        && tags[0] is string
        && tags[0].size() > 0
        && tags[0].size() <= 32;
    }

    // Client denormalizes headlineName (displayName || email || 'Usuario').
    function callerHeadlineName() {
      return callerProfile().get('displayName', '') is string
          && callerProfile().get('displayName', '').size() > 0
        ? callerProfile().get('displayName', '')
        : (callerProfile().get('email', '') is string
            && callerProfile().get('email', '').size() > 0
          ? callerProfile().get('email', '')
          : 'Usuario');
    }

    function matchesCallerIdentity(authorId, authorName, authorRole) {
      return authorId == request.auth.uid
        && authorName == callerHeadlineName()
        && authorRole == callerRole();
    }

    function threadAuthorUnchanged() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorRole == resource.data.authorRole;
    }

    function replyAuthorUnchanged() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorRole == resource.data.authorRole;
    }

    match /users/{uid} {
      // Private profile: peers use /publicProfiles and never receive PII.
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && !isAnonymousAuth()
        && request.resource.data.uid == uid
        && request.resource.data.isAnonymous is bool
        && request.resource.data.isAnonymous == false
        && request.resource.data.role == 'student'
        && request.resource.data.get('approvalStatus', '') == 'pending'
        && !isProtectedRole(request.resource.data.role);

      // Owners may edit profile fields. Role is frozen except a one-time
      // student → student|agent transition when completing the profile.
      // Protected roles (admin/manager/instructor) may still edit their own
      // profile fields as long as role stays identical — no self-promotion.
      // Later upgrades require Admin SDK / setUserRole.
      // Account lifecycle + approval fields are server-managed (callables),
      // so clients can never touch them.
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.isAnonymous == resource.data.isAnonymous
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'accountStatus',
          'deactivatedAt',
          'deletionRequestedAt',
          'deletionScheduledAt',
          'anonymousLabel',
          'deletionSnapshot',
          'approvalStatus',
          'approvedBy',
          'approvedAt',
          'profileBadge',
          'email',
          'username'
        ])
        && optionalBoundedString(request.resource.data.get('bio', null), 280)
        && (
          (
            !isProtectedRole(request.resource.data.role)
            && !isProtectedRole(resource.data.role)
            && (
              request.resource.data.role == resource.data.role
              || (
                resource.data.profileCompleted == false
                && resource.data.role == 'student'
                && request.resource.data.role in ['student', 'agent']
                && request.resource.data.profileCompleted == true
              )
            )
          )
          || (
            isProtectedRole(resource.data.role)
            && request.resource.data.role == resource.data.role
          )
        );

      // Admins may update/delete any user doc (promote, lifecycle, etc.).
      allow update, delete: if isAdmin();

      match /forumVotes/{voteId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Academy progress: one doc per enrolled course, owned by the learner.
      match /enrollments/{courseId} {
        allow read: if isOwner(uid) || isAdmin();
        // Enrollment, completion, quiz attempts and counters are atomic
        // server-side operations. Admin SDK bypasses this denial.
        allow write: if false;
      }

      // In-app notification inbox — Functions create; owners may mark read.
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create, delete: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
          && resource.data.read == false
          && request.resource.data.read == true;
      }

      // FCM device tokens for push delivery.
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() < 4096
          && request.resource.data.platform in ['web', 'ios', 'android'];
        allow delete: if isOwner(uid);
      }

      // Aggregate unread + prefs + feed cursor. Counters are normally
      // server-written; owners may also decrement them when marking read
      // locally (Functions unavailable / offline).
      match /notificationState/{docId} {
        allow read: if isOwner(uid) && docId == 'default';
        allow create: if isOwner(uid)
          && docId == 'default'
          && request.resource.data.keys().hasOnly([
            'prefs', 'lastFeedSeenAt', 'updatedAt'
          ]);
        allow update: if isOwner(uid)
          && docId == 'default'
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['prefs', 'lastFeedSeenAt', 'updatedAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['unreadCount', 'unreadForumCount', 'updatedAt'])
              && request.resource.data.unreadCount is int
              && request.resource.data.unreadForumCount is int
              && request.resource.data.unreadCount >= 0
              && request.resource.data.unreadForumCount >= 0
              && request.resource.data.unreadCount
                <= resource.data.get('unreadCount', 0)
              && request.resource.data.unreadForumCount
                <= resource.data.get('unreadForumCount', 0)
            )
          );
        allow delete: if false;
      }
    }

    match /publicProfiles/{uid} {
      allow read: if isRegisteredMember();
      allow write: if false;
    }

    match /usernames/{username} {
      allow read: if isRegisteredMember();
      allow write: if false;
    }

    // Social graph: owner-only reads. Contacts and requests are Admin SDK only.
    match /social/{uid} {
      allow read, write: if false;

      match /blocks/{otherUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow create: if isOwner(uid)
          && isRegisteredMember()
          && otherUid != uid
          && otherUid.size() > 0
          && otherUid.size() <= 128
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == otherUid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /mutes/{otherUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow create: if isOwner(uid)
          && isRegisteredMember()
          && otherUid != uid
          && otherUid.size() > 0
          && otherUid.size() <= 128
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == otherUid
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /contacts/{otherUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }

      match /incomingRequests/{fromUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }

      match /outgoingRequests/{toUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }

      match /followers/{otherUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }

      match /following/{otherUid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }
    }

    // Member reports — Functions write; no client reads.
    match /moderationReports/{id} {
      allow read, write: if false;
    }

    // Server-only outbound email queue (Resend).
    match /mailOutbox/{id} {
      allow read, write: if false;
    }

    // Chats live in Realtime Database (see database.rules.json).
    match /chats/{document=**} {
      allow read, write: if false;
    }

    match /threads/{threadId} {
      allow read: if isForumParticipant();

      allow create: if isForumParticipant()
        && request.resource.data.authorId == request.auth.uid
        && matchesCallerIdentity(
          request.resource.data.authorId,
          request.resource.data.authorName,
          request.resource.data.authorRole
        )
        && boundedString(request.resource.data.title, 200)
        && boundedString(request.resource.data.body, 20000)
        && validTags(request.resource.data.tags)
        && request.resource.data.replyCount == 0
        && request.resource.data.score is int
        && request.resource.data.score == 0
        && request.resource.data.interactorCount is int
        && request.resource.data.interactorCount == 0;

      allow update: if isForumParticipant()
        && threadAuthorUnchanged()
        && request.resource.data.score is int
        && (
          // Author/admin content edit — immutable counters/score/accept.
          (
            (resource.data.authorId == request.auth.uid || isAdmin())
            && boundedString(request.resource.data.title, 200)
            && boundedString(request.resource.data.body, 20000)
            && validTags(request.resource.data.tags)
            && request.resource.data.score == resource.data.score
            && request.resource.data.replyCount == resource.data.replyCount
            && request.resource.data.interactorCount == resource.data.interactorCount
            && request.resource.data.acceptedReplyId == resource.data.acceptedReplyId
          )
          // Author/admin accept an answer.
          || (
            (resource.data.authorId == request.auth.uid || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['acceptedReplyId', 'updatedAt'])
          )
        );

      allow delete: if isForumParticipant()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      match /participants/{participantUid} {
        allow read: if isForumParticipant();
        allow write: if false;
      }

      match /votes/{uid} {
        allow read: if isForumParticipant();
        allow write: if false;
      }

      match /replies/{replyId} {
        allow read: if isForumParticipant();

        allow create: if false;

        allow update: if isForumParticipant()
          && replyAuthorUnchanged()
          && request.resource.data.score is int
          && (
            (
              (resource.data.authorId == request.auth.uid || isAdmin())
              && boundedString(request.resource.data.body, 20000)
              && request.resource.data.score == resource.data.score
            )
          );

        allow delete: if false;

        match /votes/{uid} {
          allow read: if isForumParticipant();
          allow write: if false;
        }
      }
    }

    // Academy catalog. Learners only ever see published courses; authors and
    // admins additionally see their own drafts / pending reviews.
    match /courses/{courseId} {
      allow read: if
        (resource.data.get('status', 'draft') == 'published'
          && isRegisteredMember())
        || isAdmin()
        || (
          isAccountActive()
          && (
            resource.data.get('createdBy', '') == request.auth.uid
            || request.auth.uid in resource.data.get('instructorIds', [])
          )
        );

      allow create: if isCourseAuthor()
        && request.resource.data.createdBy == request.auth.uid
        && boundedString(request.resource.data.title, 200)
        && optionalBoundedString(request.resource.data.get('description', ''), 5000)
        && optionalBoundedString(request.resource.data.get('teacherName', ''), 200)
        && validCourseLevel(request.resource.data.level)
        && validInstructorIds(request.resource.data.get('instructorIds', []))
        && request.resource.data.studentCount is int
        && request.resource.data.studentCount == 0
        && (
          isAdmin()
          || request.resource.data.status == 'draft'
        );

      allow update: if
          // Admins may edit and publish anything (still bound instructor list).
          (
            isAdmin()
            && validInstructorIds(request.resource.data.get('instructorIds', []))
          )
          // Authors iterate on their own course and can request review.
          || (
            isCourseAuthor()
            && resource.data.get('createdBy', '') == request.auth.uid
            && resource.data.get('status', 'draft') != 'published'
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.studentCount == resource.data.studentCount
            && request.resource.data.status in ['draft', 'pending']
            && boundedString(request.resource.data.title, 200)
            && optionalBoundedString(request.resource.data.get('description', ''), 5000)
            && optionalBoundedString(request.resource.data.get('teacherName', ''), 200)
            && validCourseLevel(request.resource.data.level)
            && validInstructorIds(request.resource.data.get('instructorIds', []))
            && courseAuthorUpdateKeys()
          );

      allow delete: if isAdmin()
        || (
          isCourseAuthor()
          && resource.data.get('createdBy', '') == request.auth.uid
          && resource.data.get('status', 'draft') != 'published'
        );

      match /modules/{moduleId} {
        allow read: if courseReadable(courseId);
        allow create, update: if canEditCourse(courseId)
          && moduleWriteKeys()
          && boundedString(request.resource.data.title, 200)
          && request.resource.data.order is int;
        allow delete: if canEditCourse(courseId);
      }

      match /lessons/{lessonId} {
        allow read: if courseReadable(courseId);
        allow create, update: if canEditCourse(courseId)
          && lessonWriteKeys()
          && boundedString(request.resource.data.title, 200)
          && request.resource.data.moduleId is string
          && request.resource.data.order is int
          && lessonTypeValid(request.resource.data.get('type', 'video'))
          && request.resource.data.get('questions', []) is list
          && request.resource.data.get('questions', []).size() <= 50
          && optionalBoundedString(request.resource.data.get('bodyMarkdown', ''), 100000)
          && optionalBoundedString(request.resource.data.get('videoUrl', ''), 2000)
          && optionalBoundedString(request.resource.data.get('videoPath', ''), 500)
          && optionalBoundedString(request.resource.data.get('videoFileName', ''), 300)
          && (
            !('instructorId' in request.resource.data)
            || request.resource.data.instructorId == null
            || (
              request.resource.data.instructorId is string
              && request.resource.data.instructorId.size() <= 128
            )
          );
        allow delete: if canEditCourse(courseId);

        // Quiz answer keys: authors and admins only. Learners never read them;
        // grading happens in the submitQuizAttempt callable (Admin SDK).
        match /secure/{secureId} {
          allow read: if isAdmin()
            || (isCourseAuthor() && courseExists(courseId)
              && (ownsCourse(courseId) || instructsCourse(courseId)));
          allow create, update: if canEditCourse(courseId)
            && request.resource.data.keys().hasOnly(['answers', 'updatedAt']);
          allow delete: if canEditCourse(courseId);
        }
      }

      // Creator analytics rollups — aggregate only; Admin SDK writes.
      match /analytics/{docId} {
        allow read: if canReadCourseAnalytics(courseId);
        allow write: if false;
      }
      match /analyticsDays/{dayId} {
        allow read: if canReadCourseAnalytics(courseId);
        allow write: if false;
      }
      match /lessonAnalytics/{lessonId} {
        allow read: if canReadCourseAnalytics(courseId);
        allow write: if false;
      }
      match /analyticsSessions/{sessionId} {
        allow read, write: if false;
      }
    }

    // Learning paths: instructors/managers draft and submit; admins publish.
    match /paths/{pathId} {
      allow read: if
        (resource.data.get('status', 'draft') == 'published'
          && isRegisteredMember())
        || isAdmin()
        || (
          isAccountActive()
          && resource.data.get('createdBy', '') == request.auth.uid
        );

      allow create: if isCourseAuthor()
        && request.resource.data.createdBy == request.auth.uid
        && boundedString(request.resource.data.title, 200)
        && validCourseLevel(request.resource.data.level)
        && request.resource.data.courseIds is list
        && request.resource.data.courseIds.size() <= 100
        && request.resource.data.order is int
        && (
          isAdmin()
          || request.resource.data.status == 'draft'
        );

      allow update: if
          isAdmin()
          || (
            isCourseAuthor()
            && resource.data.get('createdBy', '') == request.auth.uid
            && resource.data.get('status', 'draft') != 'published'
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.status in ['draft', 'pending']
            && boundedString(request.resource.data.title, 200)
            && validCourseLevel(request.resource.data.level)
            && request.resource.data.courseIds is list
            && request.resource.data.courseIds.size() <= 100
          );

      allow delete: if isAdmin()
        || (
          isCourseAuthor()
          && resource.data.get('createdBy', '') == request.auth.uid
          && resource.data.get('status', 'draft') != 'published'
        );
    }

    // Cross-user enrollment scans are admin-only. Studio authors use
    // courses/{id}/analytics rollups for enrolled/completed counts.
    match /{path=**}/enrollments/{enrollmentId} {
      allow read: if isAdmin();
    }

    // Ephemeral analytics helpers written only by Admin SDK / Functions.
    match /analyticsDedupe/{id} {
      allow read, write: if false;
    }
    match /analyticsViewerDays/{id} {
      allow read, write: if false;
    }

    match /functionUsage/{counterId} {
      allow read, write: if false;
    }

    // Opaque SSO handoff codes + rate counters — Admin SDK only.
    match /ssoHandoffs/{code} {
      allow read, write: if false;
    }

    match /ssoRateLimit/{counterId} {
      allow read, write: if false;
    }

    // Role permission documents — registered members hydrate Auth; writes via Functions.
    // Seed `roles/{id}` in every environment (`seedSystemRoles`).
    match /roles/{roleId} {
      allow read: if isRegisteredMember();
      allow write: if false;
    }

    // Promo banners — registered members hydrate active promos; writes via Functions.
    match /promoBanners/{bannerId} {
      allow read: if isRegisteredMember()
        && resource.data.get('active', false) == true;
      allow write: if false;
    }

    match /polls/{pollId} {
      allow read: if isRegisteredMember();
      allow write: if false;
      match /votes/{uid} {
        allow read: if isOwner(uid) && isRegisteredMember();
        allow write: if false;
      }
    }

    // Org tree — mutations and reads go through Cloud Functions (Admin SDK).
    match /orgNodes/{nodeId} {
      allow read, write: if false;
    }

    // Payments / Override Management — admin read; all writes via Functions.
    function canAccessPaymentsData() {
      return isAdmin() || hasPermission('apps.payments.access');
    }

    match /paymentsParticipants/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /businessRelationships/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /contractTerms/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /carriers/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /carrierStateRates/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /statements/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /statementLines/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /overrideRuns/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /overrideAllocations/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /reconciliationItems/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    // Compensation plans layer (override tiers / groups / plans / routing).
    // Same policy as core payments: payments-admin read; writes via Functions only.
    match /compensationTiers/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /agentRateGroups/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /compensationPlans/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /planAssignments/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /paymentRouting/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    // Commission Runs module (ADR-008) — payments-admin read; writes via Functions.
    match /commissionRuns/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionSourceFiles/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionImportProfiles/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionTransactions/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionRules/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionRuleVersions/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionValidationIssues/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionCalculations/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionAllocations/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionStatements/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionStatementVersions/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionNotifications/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionAuditEvents/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /commissionSettings/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }
    match /agencyPayModes/{id} {
      allow read: if canAccessPaymentsData();
      allow write: if false;
    }

    // Aggregate platform counts (Admin SDK writes). Registered-member read for
    // proportional feed rules (e.g. Spotlight reach vs active audience).
    match /platformStats/{docId} {
      allow read: if isRegisteredMember();
      allow write: if false;
    }

    // Required for collectionGroup('replies') queries (avatar photo sync).
    // Nested match /threads/.../replies alone does not cover collection groups.
    match /{path=**}/replies/{replyId} {
      allow read: if isForumParticipant();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
