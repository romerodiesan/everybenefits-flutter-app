rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAnonymousAuth() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function callerProfile() {
      return userDoc(request.auth.uid).data;
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerRole() {
      return callerProfile().role;
    }

    function isAdmin() {
      return hasUserProfile() && callerRole() == 'admin';
    }

    function isForumParticipant() {
      return hasUserProfile()
        && !callerProfile().isAnonymous
        && callerRole() in ['student', 'agent', 'instructor', 'admin'];
    }

    function isProtectedRole(role) {
      return role in ['instructor', 'admin'];
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function boundedString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function optionalBoundedString(value, maxLen) {
      return value == null
        || (value is string && value.size() <= maxLen);
    }

    function validTags(tags) {
      return tags is list
        && tags.size() > 0
        && tags.size() <= 5
        && tags[0] is string
        && tags[0].size() > 0
        && tags[0].size() <= 32;
    }

    // Client denormalizes headlineName (displayName || email || 'Usuario').
    function callerHeadlineName() {
      return callerProfile().displayName is string
          && callerProfile().displayName.size() > 0
        ? callerProfile().displayName
        : (callerProfile().email is string
            && callerProfile().email.size() > 0
          ? callerProfile().email
          : 'Usuario');
    }

    function matchesCallerIdentity(authorId, authorName, authorRole) {
      return authorId == request.auth.uid
        && authorName == callerHeadlineName()
        && authorRole == callerRole();
    }

    function notVotingOwnThread(threadId) {
      return get(/databases/$(database)/documents/threads/$(threadId)).data.authorId
        != request.auth.uid;
    }

    function notVotingOwnReply(threadId, replyId) {
      return get(/databases/$(database)/documents/threads/$(threadId)/replies/$(replyId)).data.authorId
        != request.auth.uid;
    }

    function threadAuthorUnchanged() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorRole == resource.data.authorRole;
    }

    function replyAuthorUnchanged() {
      return request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.authorRole == resource.data.authorRole;
    }

    function scoreDeltaWithinVoteRange() {
      return request.resource.data.score is int
        && resource.data.score is int
        && request.resource.data.score - resource.data.score <= 2
        && request.resource.data.score - resource.data.score >= -2;
    }

    match /users/{uid} {
      // Directory: participants may list peers; full PII still readable to
      // participants (narrowed projection is a follow-up schema change).
      allow read: if isOwner(uid) || isAdmin() || isForumParticipant();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.isAnonymous is bool
        && (
          (
            isAnonymousAuth()
            && request.resource.data.role == 'guest'
            && request.resource.data.isAnonymous == true
          )
          || (
            !isAnonymousAuth()
            && request.resource.data.role in ['student', 'agent']
            && request.resource.data.isAnonymous == false
            && !isProtectedRole(request.resource.data.role)
          )
        );

      // Owners may edit profile fields. Role is frozen except student↔agent
      // (profile completion). Privileged roles require Admin SDK / callable.
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.isAnonymous == resource.data.isAnonymous
        && !isProtectedRole(request.resource.data.role)
        && !isProtectedRole(resource.data.role)
        && (
          request.resource.data.role == resource.data.role
          || (
            resource.data.role in ['student', 'agent']
            && request.resource.data.role in ['student', 'agent']
          )
        );

      allow update, delete: if isAdmin();
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && isChatMemberData(
          get(/databases/$(database)/documents/chats/$(chatId)).data
        );
    }

    function isChatMemberData(data) {
      return data.keys().hasAll(['memberIds'])
        && data.memberIds is list
        && request.auth.uid in data.memberIds;
    }

    function chatUpdateKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastMessageSenderId',
          'unreadCounts',
          'pinnedBy',
          'memberNames',
          'title',
        ]);
    }

    match /chats/{chatId} {
      allow get: if isForumParticipant() && (
        resource == null
        || isChatMemberData(resource.data)
      );
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create: if isForumParticipant()
        && request.resource.data.createdBy == request.auth.uid
        && isChatMemberData(request.resource.data)
        && request.resource.data.isGroup is bool
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && (
          (
            request.resource.data.isGroup == false
            && request.resource.data.memberIds.size() == 2
            && request.resource.data.dmKey is string
            && request.resource.data.dmKey == chatId
          )
          || (
            request.resource.data.isGroup == true
            && request.resource.data.memberIds.size() >= 2
            && request.resource.data.memberIds.size() <= 20
          )
        );

      allow update: if isSignedIn()
        && isChatMemberData(resource.data)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.dmKey == resource.data.dmKey
        && request.resource.data.isGroup == resource.data.isGroup
        && chatUpdateKeysOk()
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && isForumParticipant()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && request.resource.data.senderName == callerHeadlineName()
          && (
            (
              boundedString(request.resource.data.body, 4000)
            )
            || (
              request.resource.data.keys().hasAll(['sharedPost'])
              && request.resource.data.sharedPost.keys()
                .hasAll(['threadId', 'title'])
              && boundedString(request.resource.data.sharedPost.threadId, 128)
              && boundedString(request.resource.data.sharedPost.title, 200)
            )
          );

        allow update, delete: if false;
      }
    }

    match /threads/{threadId} {
      allow read: if isSignedIn();

      allow create: if isForumParticipant()
        && request.resource.data.authorId == request.auth.uid
        && matchesCallerIdentity(
          request.resource.data.authorId,
          request.resource.data.authorName,
          request.resource.data.authorRole
        )
        && boundedString(request.resource.data.title, 200)
        && boundedString(request.resource.data.body, 20000)
        && validTags(request.resource.data.tags)
        && request.resource.data.replyCount == 0
        && request.resource.data.score is int
        && request.resource.data.score == 0;

      allow update: if isSignedIn()
        && threadAuthorUnchanged()
        && request.resource.data.score is int
        && (
          // Author/admin content edit — immutable counters/score/accept.
          (
            (resource.data.authorId == request.auth.uid || isAdmin())
            && boundedString(request.resource.data.title, 200)
            && boundedString(request.resource.data.body, 20000)
            && validTags(request.resource.data.tags)
            && request.resource.data.score == resource.data.score
            && request.resource.data.replyCount == resource.data.replyCount
            && request.resource.data.acceptedReplyId == resource.data.acceptedReplyId
          )
          // Author/admin accept an answer.
          || (
            (resource.data.authorId == request.auth.uid || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['acceptedReplyId', 'updatedAt'])
          )
          // Vote score bump (max ±2 per write).
          || (
            isForumParticipant()
            && request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.tags == resource.data.tags
            && request.resource.data.replyCount == resource.data.replyCount
            && request.resource.data.acceptedReplyId == resource.data.acceptedReplyId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['score', 'updatedAt'])
            && scoreDeltaWithinVoteRange()
          )
          // Reply create/delete counters (accept may clear only with replyCount).
          || (
            isForumParticipant()
            && request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.tags == resource.data.tags
            && request.resource.data.score == resource.data.score
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['replyCount', 'lastReplyAt', 'updatedAt', 'acceptedReplyId'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['replyCount'])
          )
        );

      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create, update: if isForumParticipant()
          && request.auth.uid == uid
          && notVotingOwnThread(threadId)
          && request.resource.data.value is int
          && (request.resource.data.value == 1
              || request.resource.data.value == -1);
        allow delete: if isForumParticipant()
          && request.auth.uid == uid;
      }

      match /replies/{replyId} {
        allow read: if isSignedIn();

        allow create: if isForumParticipant()
          && request.resource.data.authorId == request.auth.uid
          && matchesCallerIdentity(
            request.resource.data.authorId,
            request.resource.data.authorName,
            request.resource.data.authorRole
          )
          && boundedString(request.resource.data.body, 20000)
          && request.resource.data.score is int
          && request.resource.data.score == 0;

        allow update: if isSignedIn()
          && replyAuthorUnchanged()
          && request.resource.data.score is int
          && (
            (
              (resource.data.authorId == request.auth.uid || isAdmin())
              && boundedString(request.resource.data.body, 20000)
              && request.resource.data.score == resource.data.score
            )
            || (
              isForumParticipant()
              && request.resource.data.body == resource.data.body
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['score', 'updatedAt'])
              && scoreDeltaWithinVoteRange()
            )
          );

        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || isAdmin());

        match /votes/{uid} {
          allow read: if isSignedIn();
          allow create, update: if isForumParticipant()
            && request.auth.uid == uid
            && notVotingOwnReply(threadId, replyId)
            && request.resource.data.value is int
            && (request.resource.data.value == 1
                || request.resource.data.value == -1);
          allow delete: if isForumParticipant()
            && request.auth.uid == uid;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
